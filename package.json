{
  "name": "drkryz-roundedtabs",
  "displayName": "Drkryz RoundedTabs",
  "description": "Safely inject rounded tabs, softer workbench surfaces, and optional animations into VS Code while keeping the original workbench CSS reversible.",
  "publisher": "drkryz",
  "icon": "dist/icon/logo_bg_none.png",
  "version": "0.4.3",
  "galleryBanner": {
    "color": "#070707",
    "theme": "dark"
  },
  "keywords": [
    "rounded tabs",
    "vscode ui",
    "workbench css",
    "custom vscode",
    "soft ui",
    "vscode animations"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drpidman/drkryz-roundedtabs"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:drkryz-roundedtabs.configure_now",
    "onCommand:drkryz-roundedtabs.restore",
    "onCommand:drkryz-roundedtabs.enableAnimations",
    "onCommand:drkryz-roundedtabs.disableAnimations"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "RoundedTabs",
      "properties": {
        "drkryz-roundedtabs.autoReapplyOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reapply the managed rounded CSS block if VS Code updates its workbench CSS."
        },
        "drkryz-roundedtabs.stylePreset": {
          "type": "string",
          "enum": [
            "balanced",
            "tabs-only"
          ],
          "default": "balanced",
          "markdownEnumDescriptions": [
            "Rounds tabs, sidebar, activity bar, panel, quick input, notifications, and safe list surfaces.",
            "Rounds only the editor tabs plus the main sidebar and auxiliary containers."
          ],
          "description": "Controls how broadly RoundedTabs applies rounded surfaces."
        },
        "drkryz-roundedtabs.radius": {
          "type": "number",
          "default": 12,
          "minimum": 6,
          "maximum": 24,
          "description": "Base corner radius used by the RoundedTabs managed CSS block."
        },
        "drkryz-roundedtabs.tabGap": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 12,
          "description": "Gap used between editor tabs when RoundedTabs is active."
        },
        "drkryz-roundedtabs.enableAnimations": {
          "type": "boolean",
          "default": false,
          "description": "Adds subtle animations to tabs, quick input, context menus, notifications, and header actions. Disabled by default to keep the workbench conservative."
        },
        "drkryz-roundedtabs.installPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom VS Code installation root, resources folder, or direct path to workbench.desktop.main.css."
        }
      }
    },
    "commands": [
      {
        "command": "drkryz-roundedtabs.configure_now",
        "title": "Apply Rounded Tabs",
        "shortTitle": "Apply Rounded Tabs",
        "category": "RoundedTabs"
      },
      {
        "command": "drkryz-roundedtabs.restore",
        "title": "Restore Defaults",
        "shortTitle": "Restore VS Code Defaults",
        "category": "RoundedTabs"
      },
      {
        "command": "drkryz-roundedtabs.enableAnimations",
        "title": "Enable Soft Animations",
        "shortTitle": "Enable Soft Animations",
        "category": "RoundedTabs"
      },
      {
        "command": "drkryz-roundedtabs.disableAnimations",
        "title": "Disable Soft Animations",
        "shortTitle": "Disable Soft Animations",
        "category": "RoundedTabs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "2.5.2",
    "eslint": "^10.0.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "postcss": "^8.5.8"
  }
}
